{
  "name": "st-rsuite-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.mjs",
    "build:dev": "NODE_ENV=development bun build.mjs",
    "dev": "NODE_ENV=development bun build.mjs --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun fmt --check . && bun lint --max-warnings 0 && bun run typecheck && bun test"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@rsuite/icons": "^1.4.0",
    "@streamlit/component-v2-lib": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "rsuite": "^6.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^6.0.3",
    "terser": "^5.48.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.4",
    "vite-plugin-css-injected-by-js": "^4.0.1"
  }
}
